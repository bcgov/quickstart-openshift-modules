{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Presets from https://github.com/bcgov/renovate-config",
  "extends": [
    "github>bcgov/renovate-config#2026.9.26"
  ],
  "minimumReleaseAge": "0 days",
  "packageRules": [
    {
      "description": "Lock Eclipse Temurin to Java 21 LTS for backend-java development service",
      "matchPackageNames": [
        "eclipse-temurin",
        "docker.io/library/eclipse-temurin"
      ],
      "allowedVersions": "<22"
    }
  ]
}
